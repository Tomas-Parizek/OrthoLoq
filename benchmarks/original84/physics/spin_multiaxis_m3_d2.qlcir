5 = not(4)
6 = and(state, axis1_plus)
7 = not(axis1_plus)
8 = and(state, 7)
9 = or(6, 8)
10 = not(9)
11 = and(state, axis2_plus)
12 = not(axis2_plus)
13 = and(state, 12)
14 = or(11, 13)
15 = not(14)
16 = and(state, 5, 10, 15)
