#QLCIR-G1
# name: modular_subspace_w2_d3
# family: physics/modular-subspace-reconstruction
# tier: 2
# expected: UNSAT
# parameters: width=2;d=3
# note: Negation of modular subspace reconstruction under U<=W, with U,V,X themselves coarse subspaces.
dim(3)
output(10)
1 = or(u0, u1)
2 = or(v0, v1)
3 = or(x0, x1)
4 = or(1, 3)
5 = and(2, 4)
6 = or(1, 5)
7 = or(1, 2)
8 = and(7, 4)
9 = not(6)
10 = and(8, 9)
