#QLCIR-G1
# name: grouped_interference_g2_w2_d2
# family: physics/grouped-interferometers
# tier: 1
# expected: SAT
# parameters: groups=2;width=2;d=2
# note: Grouped path alternatives form a coarse interferometer; psi is not reconstructed from groupwise meets.
dim(2)
output(8)
1 = or(path_0_0, path_0_1)
2 = or(path_1_0, path_1_1)
3 = or(1, 2)
4 = and(psi, 1)
5 = and(psi, 2)
6 = or(4, 5)
7 = not(6)
8 = and(psi, 3, 7)
